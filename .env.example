# Copy to .env.local for development. Never commit real values.
# On Netlify, set the same names under Site configuration > Environment variables.

# Public URL of the site (used for canonical URLs, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (Resend, https://resend.com).
# Without these, development logs messages to the terminal instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender address on a domain you verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (spam protection). Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
