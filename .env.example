# Copy to .env.local for development. Never commit real values.
# On Netlify, set the same names under Site configuration > Environment variables.

# Public URL of the site (used for canonical URLs, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (Brevo, https://www.brevo.com).
# Without these, development logs messages to the terminal instead of sending.
# API key: Brevo > profile menu > SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=
# Where contact messages are delivered (your own inbox).
CONTACT_TO_EMAIL=
# The "from" address: a plain email address (no display name) that is a verified
# sender or sits on a verified domain in Brevo, e.g. contact@davon-whitworth.com
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (spam protection). Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
